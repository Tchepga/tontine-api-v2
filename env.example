# Configuration JWT
JWT_SECRET=votre-secret-jwt-super-securise
JWT_EXPIRES_IN=24h

# Configuration Base de données
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=root
DB_DATABASE=tontine
# Production : false (migrations via npm run migration:run). Dev local : true possible.
DB_SYNCHRONIZE=false

# Configuration Mots de passe
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=100
DEFAULT_PASSWORD=changeme1@

# Resend (emails de bienvenue à l'inscription)
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=Tontine <onboarding@yourdomain.com>

# Monitoring (Sentry — optionnel en local, recommandé en prod)
SENTRY_DSN=

# CORS (origines autorisées, séparées par virgule ; * pour tout autoriser)
CORS_ORIGINS=*

# Environnement
NODE_ENV=production
# Port HTTP (défaut 8080). Bind sur 0.0.0.0 pour reverse proxy / VPS.
PORT=8080
